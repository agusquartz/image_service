# HTTP interface used by the image service.
IMAGE_BIND=127.0.0.1:3000


IMAGE_STORAGE_SCHEME=fs

# Optional local filesystem root.
#
# If omitted, the operating system's local application-data directory
# is used.
#
# Linux:
# ~/.local/share/image-service/images
#
# IMAGE_STORAGE_ROOT=/var/lib/image-service/images



# Optional OpenDAL atomic-write directory.
#
# If omitted for filesystem storage, the service uses:
#
# <IMAGE_STORAGE_ROOT>/.tmp
#
# IMAGE_STORAGE_ATOMIC_WRITE_DIR=/var/lib/image-service/images/.tmp


# S3 / S3-compatible example:
#
# IMAGE_STORAGE_SCHEME=s3
# IMAGE_STORAGE_BUCKET=my-images
# IMAGE_STORAGE_REGION=us-east-1
# IMAGE_STORAGE_ACCESS_KEY_ID=...
# IMAGE_STORAGE_SECRET_ACCESS_KEY=...
#
# Optional custom endpoint for R2, MinIO, OCI, etc.
# IMAGE_STORAGE_ENDPOINT=https://example.com


# Maximum number of images that may be decoded/compressed concurrently.
#
# Image processing is CPU and memory intensive, so keeping this value
# relatively low is recommended.
IMAGE_MAX_CONCURRENCY=2

# Maximum uploaded image payload (excluding multipart framing), in bytes.
# The default preserves the previous 15 MiB input limit. Must be a positive byte count.
IMAGE_MAX_INPUT_BYTES=15728640

# Maximum stored WebP size, in bytes. Must be a positive byte count; default is 100 KiB.
IMAGE_MAX_OUTPUT_BYTES=102400

# Target dimensions of stored WebP images. The image is center-cropped to this
# aspect ratio and may be further downscaled to meet the output-byte limit.
IMAGE_OUTPUT_WIDTH=1024
IMAGE_OUTPUT_HEIGHT=1024

# Optional named WebP processing profiles assigned by namespace.
# Profile fields override only the matching global setting above; omitted
# fields keep their global value. Width and height must be provided together.
# IMAGE_PROCESSING_PROFILES='{"product":{"max_input_bytes":18874368,"max_output_bytes":409600,"output_width":2000,"output_height":2000},"avatar":{"output_width":512,"output_height":512}}'
# IMAGE_NAMESPACE_PROFILES='{"products":"product","users":"avatar"}'

# Highest slot number allowed for creating a new slot (global). Valid range: 1..=255.
# Defaults to 5; slot numbering always starts at 1.
IMAGE_MAX_SLOTS=5


# Authentication is required for reads and writes by default. The service
# refuses to start without IMAGE_API_KEY unless both policies are explicitly
# set to "none". Replace this example with a long random secret.
IMAGE_API_KEY=replace-with-a-long-random-secret
IMAGE_READ_AUTH=required
IMAGE_WRITE_AUTH=required

# For a public image catalog, use public reads but keep writes protected:
# IMAGE_READ_AUTH=none
# IMAGE_WRITE_AUTH=required
# For a controlled environment with no authentication, explicitly set both:
# IMAGE_READ_AUTH=none
# IMAGE_WRITE_AUTH=none

# Per-client fixed-window rate limits. Set either request count to 0 to disable
# that class. Defaults: 600 reads and 60 writes per 60 seconds.
IMAGE_RATE_LIMIT_READ_REQUESTS=600
IMAGE_RATE_LIMIT_WRITE_REQUESTS=60
IMAGE_RATE_LIMIT_WINDOW_SECONDS=60

# Enable the Prometheus endpoint at /metrics (default: false).
IMAGE_METRICS_ENABLED=false
# Require the API key when /metrics is enabled (default: true).
IMAGE_METRICS_AUTH=true

# Lifetime for presigned GET URLs. Valid range: 1..=604800 seconds.
IMAGE_PRESIGN_TTL_SECONDS=3600

# Default cache lifetime for image GET and HEAD responses, in seconds.
# Defaults to 60. Set to 0 to disable storage in caches (Cache-Control: no-store).
IMAGE_CACHE_TTL_SECONDS=60
# Optional Cache-Control override for image GET and HEAD responses.
# Without an override, responses are public when IMAGE_READ_AUTH=none and private otherwise.
# Do not use immutable: uploading another image to a slot keeps its URL.
# IMAGE_CACHE_CONTROL=public, max-age=300


# Optional externally visible base URL.
#
# Without this value, upload responses contain relative URLs.
#
# IMAGE_PUBLIC_BASE_URL=https://images.example.com

# HTTP interface used by the image service.
IMAGE_BIND=127.0.0.1:3000


IMAGE_STORAGE_SCHEME=fs

# Optional local filesystem root.
#
# If omitted, the operating system's local application-data directory
# is used.
#
# Linux:
# ~/.local/share/image-service/images
#
# IMAGE_STORAGE_ROOT=/var/lib/image-service/images



# Optional OpenDAL atomic-write directory.
#
# If omitted for filesystem storage, the service uses:
#
# <IMAGE_STORAGE_ROOT>/.tmp
#
# IMAGE_STORAGE_ATOMIC_WRITE_DIR=/var/lib/image-service/images/.tmp


# S3 / S3-compatible example:
#
# IMAGE_STORAGE_SCHEME=s3
# IMAGE_STORAGE_BUCKET=my-images
# IMAGE_STORAGE_REGION=us-east-1
# IMAGE_STORAGE_ACCESS_KEY_ID=...
# IMAGE_STORAGE_SECRET_ACCESS_KEY=...
#
# Optional custom endpoint for R2, MinIO, OCI, etc.
# IMAGE_STORAGE_ENDPOINT=https://example.com


# Maximum number of images that may be decoded/compressed concurrently.
#
# Image processing is CPU and memory intensive, so keeping this value
# relatively low is recommended.
IMAGE_MAX_CONCURRENCY=2


# Optional API key protecting POST requests.
#
# Clients must send:
#
# Authorization: Bearer <value>
#
# IMAGE_API_KEY=change-me


# Optional externally visible base URL.
#
# Without this value, upload responses contain relative URLs.
#
# IMAGE_PUBLIC_BASE_URL=https://images.example.com

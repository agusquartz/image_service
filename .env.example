# HTTP interface used by the image service.
IMAGE_BIND=127.0.0.1:3000


# Optional custom storage directory.
#
# If omitted, the application uses the operating system's local
# application-data directory:
#
# Linux:
# ~/.local/share/image-service/images
#
# Windows:
# %LOCALAPPDATA%\image-service\images
#
# macOS:
# ~/Library/Application Support/image-service/images
#
# IMAGE_SERVICE_DIR=/var/lib/image-service/images


# Maximum number of images that may be decoded/compressed concurrently.
#
# Image processing is CPU and memory intensive, so keeping this value
# relatively low is recommended.
IMAGE_MAX_CONCURRENCY=2


# Optional API key protecting POST requests.
#
# Clients must send:
#
# Authorization: Bearer <value>
#
# IMAGE_API_KEY=change-me


# Optional externally visible base URL.
#
# Without this value, upload responses contain relative URLs.
#
# IMAGE_PUBLIC_BASE_URL=https://images.example.com
